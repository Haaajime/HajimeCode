# 复制为 .env 后填入真实密钥；.env 已被 .gitignore 忽略，严禁提交。
# 若本目录没有 .env，配置层会自动回退读取 ../HajimeCode/.env。

DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 循环与预算护栏
MAX_STEPS=24
MAX_ATTEMPTS=2
TEMPERATURE=0.0
MAX_TOKENS=4096

# 成本核算单价（元 / 百万 token）——占位值，务必按官方定价校准后再引用结论
PRICE_CACHE_HIT_PER_MTOK=0.2
PRICE_CACHE_MISS_PER_MTOK=2.0
PRICE_OUTPUT_PER_MTOK=3.0
